rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true);
    }

    // 2. Comments validation
    function isValidComment(data) {
      return data.keys().hasAll(['chapterId', 'author', 'content', 'likes', 'createdAt'])
        && data.keys().size() == 5
        && data.chapterId is string && data.chapterId.size() <= 128
        && data.author is string && data.author.size() >= 1 && data.author.size() <= 50
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 1000
        && data.likes is number
        && data.createdAt == request.time;
    }

    // 3. Message validation (Supports Google authenticated users who are email-verified)
    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'userPhoto', 'content', 'category', 'createdAt'])
        && data.keys().size() == 7
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.userName is string && data.userName.size() <= 100
        && data.userPhoto is string && data.userPhoto.size() <= 500
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 2000
        && data.category is string && (data.category == 'general' || data.category == 'benchmark' || data.category == 'error')
        && data.createdAt is timestamp;
    }

    // 4. Benchmark validation
    function isValidBenchmark(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'gpuModel', 'cpuModel', 'os', 'llmSpeed', 'sdTime', 'createdAt'])
        && (data.keys().size() == 9 || (data.keys().size() == 10 && data.keys().hasAll(['fluxTime'])))
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.userName is string && data.userName.size() <= 100
        && data.gpuModel is string && data.gpuModel.size() <= 150
        && data.cpuModel is string && data.cpuModel.size() <= 150
        && data.os is string && (data.os == 'windows' || data.os == 'wsl2' || data.os == 'ubuntu')
        && data.llmSpeed is number && data.llmSpeed >= 0.0 && data.llmSpeed <= 10000.0
        && data.sdTime is number && data.sdTime >= 0.0 && data.sdTime <= 100000.0
        && (!data.keys().hasAll(['fluxTime']) || (data.fluxTime is number && data.fluxTime >= 0.0 && data.fluxTime <= 100000.0))
        && data.createdAt is timestamp;
    }

    match /video_comments/{commentId} {
      allow create: if isValidId(commentId)
        && isValidComment(incoming())
        && incoming().likes == 0;

      allow read: if true; // Publicly readable so visitors can see debate

      allow update: if isValidId(commentId)
        && isValidComment(incoming())
        && incoming().chapterId == existing().chapterId
        && incoming().author == existing().author
        && incoming().content == existing().content
        && incoming().createdAt == existing().createdAt
        && (incoming().likes == existing().likes + 1 || incoming().likes == existing().likes - 1); // allow liking/unliking

      allow delete: if false; // Visitors cannot delete discussions
    }

    match /messages/{messageId} {
      allow create: if isValidId(messageId)
        && isEmailVerified()
        && incoming().userId == request.auth.uid
        && isValidMessage(incoming());

      allow read: if true;

      allow update: if false;

      allow delete: if isEmailVerified()
        && existing().userId == request.auth.uid;
    }

    match /benchmarks/{benchmarkId} {
      allow create: if isValidId(benchmarkId)
        && isEmailVerified()
        && incoming().userId == request.auth.uid
        && isValidBenchmark(incoming());

      allow read: if true;

      allow update: if false;

      allow delete: if isEmailVerified()
        && existing().userId == request.auth.uid;
    }
  }
}
